---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo } from '../config/seo';
import { getPageSeoEntry } from '../config/pageSeo';
import { organizationSchema, webPageSchema, websiteSchema } from '../utils/schema';
const seo = resolvePageSeo('/');
const homeSeo = getPageSeoEntry('/');
const heroH1 = homeSeo?.h1 ?? 'Arc Raiders Cheats & Hacks: ESP, Aimbot & Radar';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    webPageSchema({
      name: heroH1,
      description: seo.description,
      url: '/',
    }),
  ]}
>
  <HeroSection heroTitle={heroH1} />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
