---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';
import { getPageSeoEntry } from '../config/pageSeo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const supportSeo = getPageSeoEntry('/support/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: supportSeo?.h1 ?? 'Delta Force Support',
      description: seo.description,
      url: '/support/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Support', path: '/support/' },
      ]}
    />
  </div>
  <ContactSupportSection titleId="support-page-title" pageTitle={supportSeo?.h1} />
</BaseLayout>