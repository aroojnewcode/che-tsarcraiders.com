---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, cheatPages, productPages } from '../../../data/products';
import { t } from '../../../i18n';
import { resolvePageSeo } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import CompareTable from '../../../components/CompareTable.astro';
import { compareRows } from '../../../data/faq';
import { formatPlanPrice, getProductPlans, lowestPlanPriceUsd } from '../../../data/productPricing';
import { productPath, ROUTES } from '../../../utils/path';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { Button } from '@/components/starwind/button';
import { checkoutPath } from '../../../config/checkout';
import { externalLinkProps } from '../../../utils/externalLink';

const seo = resolvePageSeo('/products/arc-raiders-hacks/');
const seoEntry = getPageSeoEntry('/products/arc-raiders-hacks/');
const hubH1 = seoEntry?.h1 ?? 'Arc Raiders Hacks 2026: Lite, Pro & Elite Cheats';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const checkout = checkoutPath('arcRaiders');
const checkoutAttrs = externalLinkProps(checkout);

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}

const buyLabelBySlug: Record<string, string> = {
  lite: 'Get access',
  pro: 'Get access',
  elite: 'Get access',
  'hwid-spoofer': 'Get access',
  ugc: 'Get access',
  'unlock-all': 'Get access',
  'cloud-dma': 'Get access',
};

const viewLabelBySlug: Record<string, string> = {
  lite: 'View Lite ESP listing',
  pro: 'View Pro combat listing',
  elite: 'View Elite suite listing',
  'hwid-spoofer': 'View HWID spoofer listing',
  ugc: 'View UGC recovery listing',
  'unlock-all': 'View camouflage listing',
  'cloud-dma': 'View Cloud DMA listing',
};

const tierPages = cheatPages.filter((p) => p.slug !== 'elite');
const utilityPages = productPages.filter((p) => p.kind === 'utility');
const cheatsCopy = t.cheats;
const utilitiesCopy = t.products;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: hubH1,
      description: seo.description,
      url: '/products/arc-raiders-hacks/',
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="products-hub__hero mt-6">
        <p class="products-hub__eyebrow">{utilitiesCopy.eyebrow}</p>
        <h1 class="text-3xl font-bold uppercase leading-tight md:text-4xl">{hubH1}</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{productHub.description}</p>
        <div class="products-hub__actions mt-6">
          <Button as="a" href={checkout} variant="primary" size="lg" class="rounded-xl" {...checkoutAttrs}>
            Get access
          </Button>
          <Button as="a" href="/blog/lite-vs-pro/" variant="outline" size="lg" class="rounded-xl">
            Lite vs Pro guide
          </Button>
        </div>
      </header>

      <section class="products-hub__block mt-14" aria-labelledby="hub-tiers-title">
        <p class="products-hub__eyebrow">{cheatsCopy.eyebrow}</p>
        <h2 id="hub-tiers-title" class="products-hub__subtitle">{cheatsCopy.title}</h2>
        <p class="products-hub__lede">{cheatsCopy.subtitle}</p>
        <div class="products-hub__grid mt-8">
          {
            tierPages.map((product) => (
              <CatalogCard
                class="catalog-card--carousel catalog-card--hub h-full"
                label={cardLabel(product)}
                title={product.title}
                href={productPath(product.slug)}
                buyUrl={product.buyUrl}
                features={product.features}
                more={product.more}
                icon={cardIcon(product)}
                badge={product.badge}
                variant={product.variant}
                buyLabel={buyLabelBySlug[product.slug] ?? 'Get access'}
                viewLabel={viewLabelBySlug[product.slug] ?? 'View product listing'}
                maxFeatures={5}
              />
            ))
          }
        </div>
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-features-title">
        <p class="products-hub__eyebrow">Feature map</p>
        <h2 id="hub-features-title" class="products-hub__subtitle">ARC ESP, containers, extraction radar, and combat modules</h2>
        <p class="products-hub__lede">
          Lite covers third-person player ESP, ARC machine ESP with bot names, drone and Snitch markers, container loot ESP, item price and rarity filters, extraction radar, OOF arrows, and a 2D radar. Pro adds memory aimbot with visibility checks. Elite bundles the full suite plus route assist and Skin Changer. Cloud DMA is a separate 2-PC hardware path.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted-foreground md:text-base">
          <li>Read the <a class="text-primary hover:underline" href="/blog/arc-raiders-esp-explained/">ESP explained</a> guide for ARC, drone, and OOF presets.</li>
          <li>See <a class="text-primary hover:underline" href="/blog/arc-raiders-loot-esp/">loot ESP</a> for container and item price filters on Topside.</li>
          <li>Compare <a class="text-primary hover:underline" href="/blog/compare-arc-raiders-cheats/">tier pricing and loader status</a> before checkout.</li>
        </ul>
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-status-title">
        <p class="products-hub__eyebrow">Cheat status</p>
        <h2 id="hub-status-title" class="products-hub__subtitle">Live Arc Raiders cheat status before every raid</h2>
        <p class="products-hub__lede">
          Check the status banner on cheatsarcraiders.com and Discord #status before you buy or launch. If a build shows updating or offline, wait for green status after Embark updates and Easy Anti-Cheat (EAC) patches. The portal repeats the same loader status after checkout.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted-foreground md:text-base">
          <li>Review patch-day notes on the <a class="text-primary hover:underline" href="/blog/patch-day/">loader status after game updates</a> guide.</li>
          <li>Compare tiers only when Lite, Pro and Elite show online for your Windows build.</li>
          <li>Never queue Topside with a loader marked testing or detected.</li>
        </ul>
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-pricing-title">
        <p class="products-hub__eyebrow">Pricing</p>
        <h2 id="hub-pricing-title" class="products-hub__subtitle">Arc Raiders cheats price per month and per day</h2>
        <p class="products-hub__lede">
          Starting checkout prices for Lite, Pro and Elite on PC (monthly plans shown with approximate price per day). Utilities use separate checkout links on their product pages.
        </p>
        <div class="mt-6 overflow-x-auto rounded-lg border border-border">
          <table class="w-full min-w-[24rem] text-left text-sm">
            <thead class="border-b border-border bg-muted/40">
              <tr>
                <th class="px-4 py-3 font-semibold">Tier</th>
                <th class="px-4 py-3 font-semibold">From (monthly)</th>
                <th class="px-4 py-3 font-semibold">≈ Per day</th>
                <th class="px-4 py-3 font-semibold">Best for</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {
                ['lite', 'pro', 'elite'].map((slug) => {
                  const monthly = getProductPlans(slug).find((p) => p.id === 'monthly');
                  const perDayUsd =
                    monthly && monthly.priceUsd > 0
                      ? (monthly.priceUsd / 30).toFixed(2)
                      : null;
                  const page = cheatPages.find((p) => p.slug === slug);
                  const bestFor =
                    slug === 'lite'
                      ? 'ARC ESP, container loot, 2D radar, third-person awareness'
                      : slug === 'pro'
                        ? 'Memory aimbot, visibility checks, recoil control'
                        : 'Full suite, route assist, Skin Changer, priority patches';
                  return (
                    <tr>
                      <td class="px-4 py-3">
                        <a class="font-medium text-primary hover:underline" href={productPath(slug)}>
                          {page?.name ?? slug}
                        </a>
                      </td>
                      <td class="px-4 py-3">
                        {monthly ? formatPlanPrice(monthly.priceUsd) : formatPlanPrice(lowestPlanPriceUsd(slug))}
                        <span class="text-muted-foreground"> / month</span>
                      </td>
                      <td class="px-4 py-3 text-muted-foreground">
                        {perDayUsd ? `$${perDayUsd}` : '—'}
                      </td>
                      <td class="px-4 py-3 text-muted-foreground">{bestFor}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="products-hub__block mt-16">
        <CompareTable rows={compareRows} />
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-external-dma-title">
        <p class="products-hub__eyebrow">Loader paths</p>
        <h2 id="hub-external-dma-title" class="products-hub__subtitle">Private external cheat vs Cloud DMA (2-PC)</h2>
        <p class="products-hub__lede">
          Lite, Pro and Elite use a private external loader on your gaming PC: overlays read game state without injecting into the client. Cloud DMA is optional hardware routing for buyers with a second PC and DMA card; it does not replace combat tiers unless you buy them separately.
        </p>
        <p class="mt-3 text-sm text-muted-foreground md:text-base">
          Read the <a class="text-primary hover:underline" href={productPath('cloud-dma')}>Cloud DMA product page</a> and <a class="text-primary hover:underline" href="/blog/external/">external loader guide</a> before you pick a path.
        </p>
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-utilities-title">
        <p class="products-hub__eyebrow">Utilities</p>
        <h2 id="hub-utilities-title" class="products-hub__subtitle">HWID, UGC, Cloud DMA &amp; Camouflage</h2>
        <p class="products-hub__lede">
          Each utility uses its own secure checkout link. Combat tiers (Lite and Pro) share the main Arc Raiders product URL.
        </p>
        <div class="products-hub__grid products-hub__grid--utilities mt-8">
          {
            utilityPages.map((product) => (
              <CatalogCard
                class="catalog-card--carousel catalog-card--hub h-full"
                label={cardLabel(product)}
                title={product.title}
                href={productPath(product.slug)}
                buyUrl={product.buyUrl}
                features={product.features}
                more={product.more}
                icon={cardIcon(product)}
                badge={product.badge}
                variant="essential"
                buyLabel={buyLabelBySlug[product.slug] ?? 'Get access'}
                viewLabel={viewLabelBySlug[product.slug] ?? 'View product listing'}
                maxFeatures={5}
              />
            ))
          }
        </div>
      </section>

      <div class="mt-12 flex flex-wrap gap-3">
        <Button as="a" href={ROUTES.productsUtilities} variant="outline">
          Compare utilities
        </Button>
        <Button as="a" href="/blog/lite-vs-pro/" variant="outline">
          Lite vs Pro guide
        </Button>
      </div>

      <div class="mt-14">
        <SeoRelatedLinks />
      </div>
    </div>
  </section>
</BaseLayout>